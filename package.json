{
  "name": "5e-to-daggerheart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Convert D&D 5e creatures into Daggerheart adversaries, in English and Portuguese.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tabler/icons-react": "^3.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=26"
  }
}
